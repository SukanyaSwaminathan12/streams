import java.util.*;
import java.util.stream.*;
    
public class Test{
    public static void main(String[] args){
    List<Employee> employees = new ArrayList<>();

    employees.add(new Employee(1,"SUK",100,"EAST"));
    employees.add(new Employee(2,"SAR",200,"WEST"));
    employees.add(new Employee(3,"SRE",400,"EAST"));
    employees.add(new Employee(4,"EGO",900,"NORTH"));
    employees.add(new Employee(5,"PRE",300,"SOUTH"));
    employees.add(new Employee(6,"RAM",500,"NORTH"));
    employees.add(new Employee(7,"ROM",600,"WEST"));
    employees.add(new Employee(8,"SUR",700,"SOUTH"));

    Map<String, Optional<Employee>> highestSalary = employees.stream().
        collect(Collectors.groupingBy(Employee::getEmployeeRegion, Collectors.maxBy(Comparator.comparing(Employee::getEmployeeSalary))));

    highestSalary.forEach((region,employee) -> 
         System.out.println("Region ::" + region + "Employee name ::" + employee.get().getEmployeeName() + "Employee Salary ::" + employee.get().getEmployeeSalary()));
    
}
}

public class Employee{
    private int employeeId;
    private String employeeName;
    private int employeeSalary;
    private String employeeRegion;

    public Employee(int employeeId,String employeeName,int employeeSalary,String employeeRegion){
        this.employeeId = employeeId;
        this.employeeName = employeeName;
        this.employeeSalary = employeeSalary;
        this.employeeRegion = employeeRegion;
    }

    public int getEmployeeId(){
        return this.employeeId;
    }
    public String getEmployeeName(){
        return this.employeeName;
    }
    public int getEmployeeSalary(){
        return this.employeeSalary;   
    }
    public String getEmployeeRegion(){
        return this.employeeRegion;
    }
}
